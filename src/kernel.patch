+#ifdef CONFIG_ARM64
+/* Opt-in recovery for this RAM-only H616/H618 USB bring-up. Android's early
+ * fatal-init reboot must not depend on the vendor kernel / TF-A reset path.
+ */
+static bool opi_usb_recovery;
+static void __iomem *opi_recovery_wdt;
+
+static int __init opi_recovery_setup(char *unused)
+{
+	opi_usb_recovery = true;
+	return 0;
+}
+early_param("opi_recovery", opi_recovery_setup);
+
+static void opi_recovery_arm(void)
+{
+	/* The one-second full-system watchdog reset is already verified in FEL. */
+	writel(0x16aa0001, opi_recovery_wdt + 0x14);
+	writel(0x16aa0011, opi_recovery_wdt + 0x18);
+	writel(0x14af, opi_recovery_wdt + 0x10);
+	mb();
+}
+
+static int opi_recovery_restart(struct notifier_block *nb,
+				unsigned long action, void *reason)
+{
+	opi_recovery_arm();
+	pr_emerg("OPI USB recovery: watchdog reset, action=%lu reason=%s\n",
+		 action, reason ? (char *)reason : "(none)");
+	/* Avoid firmware reset/poweroff handlers that may clear the watchdog. */
+	for (;;)
+		cpu_relax();
+	return NOTIFY_DONE;
+}
+
+static int opi_recovery_panic(struct notifier_block *nb,
+			      unsigned long action, void *reason)
+{
+	opi_recovery_arm();
+	pr_emerg("OPI USB recovery: panic watchdog reset armed\n");
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block opi_reboot_nb = {
+	.notifier_call = opi_recovery_restart, .priority = INT_MAX,
+};
+static struct notifier_block opi_restart_nb = {
+	.notifier_call = opi_recovery_restart, .priority = 255,
+};
+static struct notifier_block opi_panic_nb = {
+	.notifier_call = opi_recovery_panic, .priority = INT_MAX,
+};
+
+static int __init opi_recovery_init(void)
+{
+	int ret;
+
+	if (!opi_usb_recovery)
+		return 0;
+	opi_recovery_wdt = ioremap(0x030090a0, 0x20);
+	if (!opi_recovery_wdt)
+		return -ENOMEM;
+	ret = register_reboot_notifier(&opi_reboot_nb);
+	if (ret)
+		return ret;
+	ret = register_restart_handler(&opi_restart_nb);
+	if (ret) {
+		unregister_reboot_notifier(&opi_reboot_nb);
+		return ret;
+	}
+	ret = atomic_notifier_chain_register(&panic_notifier_list, &opi_panic_nb);
+	if (ret) {
+		unregister_restart_handler(&opi_restart_nb);
+		unregister_reboot_notifier(&opi_reboot_nb);
