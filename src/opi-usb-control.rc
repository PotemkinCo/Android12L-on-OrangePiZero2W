on early-init && property:ro.boot.opi_usb_boot=1
    setprop service.adb.tcp.port 5555
    setprop debug.sf.nobootanimation 1

on boot && property:ro.boot.opi_usb_boot=1
    exec u:r:su:s0 root root -- /system/bin/sh /vendor/bin/opi-usb-network-guard.sh
    setprop service.adb.tcp.port 5555
    start adbd
    start opi_usb_control

# netd initializes its INPUT chains after the early USB service starts.
on property:sys.boot_completed=1 && property:ro.boot.opi_usb_boot=1
    exec u:r:su:s0 root root -- /system/bin/sh /vendor/bin/opi-usb-network-guard.sh

on property:init.svc.netd=running && property:sys.boot_completed=1 && property:ro.boot.opi_usb_boot=1
    exec u:r:su:s0 root root -- /system/bin/sh /vendor/bin/opi-usb-network-guard.sh

service opi_usb_control /vendor/bin/busybox-opi nc -lk -s 192.168.246.2 -p 2323 -e /system/bin/sh
    class core
    disabled
    user root
    group root shell inet net_admin net_raw
    seclabel u:r:su:s0
